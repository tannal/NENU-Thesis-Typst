    table.hline(stroke: 1pt),
    [原始训练 Mini], [1.1607 ± 0.0121], [1.3843 ± 0.0243],
    [十二偏移增强 Mini], [1.2727 ± 0.0375], [1.2805 ± 0.0389],
    table.hline(stroke: 1.5pt),
